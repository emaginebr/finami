# Finami — HOMOLOGAÇÃO (docker-compose.yml)
# Copie para .env (ignorado pelo git) e ajuste os valores.

# Banco
POSTGRES_USER=finami
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=finami_homolog

# JWT (mínimo 32 bytes; a API não sobe sem ele)
JWT_SECRET=troque-por-uma-string-aleatoria-com-32-ou-mais-caracteres
JWT_ISSUER=finami
JWT_AUDIENCE=finami

# Login Google (opcional; autorize http://localhost:8080 no console do Google)
GOOGLE_CLIENT_ID=

# Portas no host
WEB_PORT=8080
API_PORT=5145
DB_PORT=5433
