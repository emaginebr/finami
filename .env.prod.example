# Finami — PRODUÇÃO (docker-compose-prod.yml)
# NÃO crie este arquivo à mão no servidor: a pipeline deploy-prod.yml gera o .env.prod
# a partir dos Secrets/Variables do GitHub (environment "production").

# --- Secrets (GitHub Secrets) ---
# PostgreSQL externo (o compose de produção não sobe banco). Evite '$' na senha.
FINAMI_CONNECTION_STRING=Host=<HOST>;Port=5432;Database=finami;Username=finami;Password=<SENHA_FORTE>;SSL Mode=Require
FINAMI_JWT_SECRET=<SEGREDO_JWT_ALEATORIO_64_CARACTERES_OU_MAIS>

# --- Configuração do ambiente (GitHub Variables; não são segredos) ---
FINAMI_DOMAIN=finami.site
FINAMI_GOOGLE_CLIENT_ID=
