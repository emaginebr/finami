# Roteiro de validação do Finami (specs/001-finami-backend-core/quickstart.md).
# Rode a API (dotnet run --project Finami.API), execute "login" e copie o token para @token.

@baseUrl = http://localhost:5145
@token = cole-o-token-aqui
@nubank = 100
@ledger = 101
@mesada = 102
@groupId = 1
@pedroId = 2
@transactionId = 1
@invitationId = 1
@guestToken = cole-o-token-do-convidado
@outsiderWallet = 999
@pedroLedger = 103

### 1. Cadastro (US1)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{ "firstName": "Ana", "lastName": "Silva", "email": "ana@exemplo.com", "password": "senha-segura-123" }

### 1. Login (US1) — copie "token" para @token
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "ana@exemplo.com", "password": "senha-segura-123" }

### 1. Usuário autenticado
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{token}}

### 1. Login Google (ID token obtido no frontend)
POST {{baseUrl}}/api/auth/google
Content-Type: application/json

{ "idToken": "<google-id-token>" }

### 2. Usuário sem login (US4) — canLogin: false
POST {{baseUrl}}/api/users
Authorization: Bearer {{token}}
Content-Type: application/json

{ "firstName": "Pedro", "lastName": "Silva" }

### 3. Grupo (US4)
POST {{baseUrl}}/api/groups
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "Família Silva" }

### 3. Incluir membro — só pessoas cadastradas por você; outras → 422 (use o convite, seção 16)
POST {{baseUrl}}/api/groups/{{groupId}}/members
Authorization: Bearer {{token}}
Content-Type: application/json

{ "userId": {{pedroId}} }

### 4. Carteira em Real (US2)
POST {{baseUrl}}/api/wallets
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "Nubank", "description": "Conta corrente", "currency": "BRL", "isVirtual": false }

### 4. Carteira em Bitcoin
POST {{baseUrl}}/api/wallets
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "Ledger", "currency": "BTC", "isVirtual": false }

### 4. Carteira do Pedro, vinculada ao grupo (responsável cria)
POST {{baseUrl}}/api/wallets
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "Mesada", "currency": "BRL", "isVirtual": true, "ownerUserId": {{pedroId}}, "groupId": {{groupId}} }

### 4. Listar carteiras
GET {{baseUrl}}/api/wallets
Authorization: Bearer {{token}}

### 5. Entrada externa (US2)
POST {{baseUrl}}/api/transactions/income
Authorization: Bearer {{token}}
Content-Type: application/json

{ "walletId": {{nubank}}, "amount": 5000.00, "description": "Salário" }

### 5. Saída externa
POST {{baseUrl}}/api/transactions/expense
Authorization: Bearer {{token}}
Content-Type: application/json

{ "walletId": {{nubank}}, "amount": 150.00, "description": "Conta de luz" }

### 6. Cotação do bitcoin (US5)
GET {{baseUrl}}/api/quotes/btc
Authorization: Bearer {{token}}

### 7. Prévia da compra de BTC (US3)
POST {{baseUrl}}/api/transactions/transfer/preview
Authorization: Bearer {{token}}
Content-Type: application/json

{ "sourceWalletId": {{nubank}}, "destinationWalletId": {{ledger}}, "amount": 1000.00 }

### 7. Compra de BTC
POST {{baseUrl}}/api/transactions/transfer
Authorization: Bearer {{token}}
Content-Type: application/json

{ "sourceWalletId": {{nubank}}, "destinationWalletId": {{ledger}}, "amount": 1000.00, "description": "Aporte" }

### 8. Venda de BTC
POST {{baseUrl}}/api/transactions/transfer
Authorization: Bearer {{token}}
Content-Type: application/json

{ "sourceWalletId": {{ledger}}, "destinationWalletId": {{nubank}}, "amount": 0.001 }

### 9. Confirmar destino de outro usuário (não é mais usado pelo app; veja a seção 18)
GET {{baseUrl}}/api/wallets/{{mesada}}/public
Authorization: Bearer {{token}}

### 9. Transferência para carteira de alguém da família (Pedro está no grupo) — vira dívida de Pedro com você
POST {{baseUrl}}/api/transactions/transfer
Authorization: Bearer {{token}}
Content-Type: application/json

{ "sourceWalletId": {{nubank}}, "destinationWalletId": {{mesada}}, "amount": 100.00, "description": "Mesada" }

### 10. Transferência acima do saldo → 201 (a carteira de origem fica negativa)
POST {{baseUrl}}/api/transactions/transfer
Authorization: Bearer {{token}}
Content-Type: application/json

{ "sourceWalletId": {{nubank}}, "destinationWalletId": {{mesada}}, "amount": 999999.00 }

### 11. Estorno (repetir → 409)
POST {{baseUrl}}/api/transactions/{{transactionId}}/reverse
Authorization: Bearer {{token}}
Content-Type: application/json

{ "description": "Lançado errado" }

### 12. Extrato da carteira (US6)
GET {{baseUrl}}/api/statements/wallets/{{nubank}}?start=2026-01-01&end=2026-12-31
Authorization: Bearer {{token}}

### 12. Extrato do usuário
GET {{baseUrl}}/api/statements/users/1?start=2026-01-01&end=2026-12-31
Authorization: Bearer {{token}}

### 12. Extrato do grupo
GET {{baseUrl}}/api/statements/groups/{{groupId}}?start=2026-01-01&end=2026-12-31
Authorization: Bearer {{token}}

### 13. Visibilidade do extrato do grupo
PUT {{baseUrl}}/api/groups/{{groupId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "statementVisibility": "MembersSummary" }

### 14. Valor como string (feature 002, api-additions.md §1)
POST {{baseUrl}}/api/transactions/income
Authorization: Bearer {{token}}
Content-Type: application/json

{ "walletId": {{ledger}}, "amount": "0.00000001", "description": "Aporte" }

### 15. Saldo por membro do grupo (feature 002, api-additions.md §2) — não membro → 404
GET {{baseUrl}}/api/groups/{{groupId}}/balances
Authorization: Bearer {{token}}

### 15. Carteiras do membro nas famílias (feature 002, api-additions.md §3)
GET {{baseUrl}}/api/users/{{pedroId}}/group-balances
Authorization: Bearer {{token}}

### 15. Minhas carteiras nas famílias (lista vazia se não houver grupos)
GET {{baseUrl}}/api/users/1/group-balances
Authorization: Bearer {{token}}

### 16. Adicionar membro: verificar o email (feature 003) — Available | Registered | AlreadyMember | PendingInvite
POST {{baseUrl}}/api/groups/{{groupId}}/member-lookup
Authorization: Bearer {{token}}
Content-Type: application/json

{ "email": " Bruno@Exemplo.com " }

### 16. Cadastrar pessoa nova e incluir na família (email opcional; email já usado → 409)
POST {{baseUrl}}/api/groups/{{groupId}}/members/new
Authorization: Bearer {{token}}
Content-Type: application/json

{ "firstName": "Lia", "lastName": "Silva", "email": null }

### 16. Convidar pessoa cadastrada (já membro ou convite pendente → 409; email inexistente → 404)
POST {{baseUrl}}/api/groups/{{groupId}}/invitations
Authorization: Bearer {{token}}
Content-Type: application/json

{ "email": "bruno@exemplo.com" }

### 16. Convites pendentes da família (status: Pending | Accepted | Declined | Canceled)
GET {{baseUrl}}/api/groups/{{groupId}}/invitations?status=Pending
Authorization: Bearer {{token}}

### 16. Cancelar convite pendente (não pendente → 409)
DELETE {{baseUrl}}/api/groups/{{groupId}}/invitations/{{invitationId}}
Authorization: Bearer {{token}}

### 16. Convidado aceita (repetir → 409 "Este convite não está mais disponível.")
POST {{baseUrl}}/api/invitations/{{invitationId}}/accept
Authorization: Bearer {{guestToken}}

### 16. Convidado recusa
POST {{baseUrl}}/api/invitations/{{invitationId}}/decline
Authorization: Bearer {{guestToken}}

### 17. Notificações (mais recentes primeiro; próxima página com beforeId = nextBeforeId)
GET {{baseUrl}}/api/notifications?limit=20
Authorization: Bearer {{guestToken}}

### 17. Contador de não lidas
GET {{baseUrl}}/api/notifications/unread-count
Authorization: Bearer {{guestToken}}

### 17. Marcar como lidas (1–100 ids; ids de outras pessoas são ignorados) → 204
POST {{baseUrl}}/api/notifications/read
Authorization: Bearer {{guestToken}}
Content-Type: application/json

{ "notificationIds": [1] }

### 18. Destinos de transferência (feature 006): sameCurrency (família, sem a origem) e conversion (do titular)
# balance null = saldo oculto para você; sem controle da origem → 403; origem desativada → 422
GET {{baseUrl}}/api/wallets/{{nubank}}/transfer-destinations
Authorization: Bearer {{token}}

### 18. Dívidas da pessoa (feature 006): direction owes (ela deve) | owed (devem a ela); sem permissão → 404
GET {{baseUrl}}/api/users/{{pedroId}}/debts
Authorization: Bearer {{token}}

### 18. Minhas dívidas (use o seu userId, de GET /api/auth/me)
GET {{baseUrl}}/api/users/1/debts
Authorization: Bearer {{token}}

### 18. Transferência para fora da família → 422 "Só é possível transferir para pessoas da sua família."
POST {{baseUrl}}/api/transactions/transfer
Authorization: Bearer {{token}}
Content-Type: application/json

{ "sourceWalletId": {{nubank}}, "destinationWalletId": {{outsiderWallet}}, "amount": 10.00 }

### 18. Compra de BTC na carteira de outra pessoa → 422 "Conversão entre real e bitcoin só entre carteiras da mesma pessoa."
POST {{baseUrl}}/api/transactions/transfer/preview
Authorization: Bearer {{token}}
Content-Type: application/json

{ "sourceWalletId": {{nubank}}, "destinationWalletId": {{pedroLedger}}, "amount": 100.00 }

### 18. Prévia de bitcoin informado em reais (BTC → BTC): sourceAmount em BTC + quote
POST {{baseUrl}}/api/transactions/transfer/preview
Authorization: Bearer {{token}}
Content-Type: application/json

{ "sourceWalletId": {{ledger}}, "destinationWalletId": {{pedroLedger}}, "amountBrl": 200.00, "description": "Presente" }

### 18. Registro de bitcoin informado em reais (grava a cotação usada); o app envia o "amount" em BTC do preview
POST {{baseUrl}}/api/transactions/transfer
Authorization: Bearer {{token}}
Content-Type: application/json

{ "sourceWalletId": {{ledger}}, "destinationWalletId": {{pedroLedger}}, "amountBrl": 200.00 }

### 18. amountBrl fora de BTC → BTC → 400; sem amount e sem amountBrl (ou os dois) → 400 "Informe o valor em bitcoin ou em reais."
POST {{baseUrl}}/api/transactions/transfer/preview
Authorization: Bearer {{token}}
Content-Type: application/json

{ "sourceWalletId": {{nubank}}, "destinationWalletId": {{mesada}}, "amountBrl": 50.00 }
